pkgname=portico-gui-bin
pkgver=@VERSION@
pkgrel=@PKGREL@
pkgdesc='Local-first, keyboard-first SSH session manager (desktop app)'
arch=('x86_64' 'aarch64')
url='@REPO_URL@'
license=('MIT OR Apache-2.0')
depends=(
  'cairo'
  'dbus'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libgcc'
  'libsoup3'
  'webkit2gtk-4.1'
)
optdepends=(
  'org.freedesktop.secrets: keep secrets in the system keyring (gnome-keyring, keepassxc...)'
  'openssh: ssh-agent, for agent authentication'
)
provides=('portico-gui')
conflicts=('portico-gui')
options=('!debug' '!strip')
source=(
  "LICENSE-MIT-${pkgver}::@RAW_URL@/v${pkgver}/LICENSE-MIT"
  "LICENSE-APACHE-${pkgver}::@RAW_URL@/v${pkgver}/LICENSE-APACHE"
)
source_x86_64=("${url}/releases/download/v${pkgver}/Portico_${pkgver}_amd64.deb")
source_aarch64=("${url}/releases/download/v${pkgver}/Portico_${pkgver}_arm64.deb")
noextract=("Portico_${pkgver}_amd64.deb" "Portico_${pkgver}_arm64.deb")
sha256sums=('@SHA_LICENSE_MIT@'
            '@SHA_LICENSE_APACHE@')
sha256sums_x86_64=('@SHA_DEB_AMD64@')
sha256sums_aarch64=('@SHA_DEB_ARM64@')

package() {
  local deb
  case "${CARCH}" in
    x86_64) deb="Portico_${pkgver}_amd64.deb" ;;
    aarch64) deb="Portico_${pkgver}_arm64.deb" ;;
  esac
  # A .deb is an ar archive: its payload is data.tar.* (/usr/bin/portico-gui,
  # the desktop entry, hicolor icons).
  bsdtar -xOf "${deb}" 'data.tar.*' | bsdtar -xf - -C "${pkgdir}" --no-same-owner
  install -Dm0644 "LICENSE-MIT-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-MIT"
  install -Dm0644 "LICENSE-APACHE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-APACHE"
}
