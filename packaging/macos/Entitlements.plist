<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Portico.app entitlements (hardened runtime, no App Sandbox).

  Only outgoing network connections are declared. No hardened-runtime exception
  is granted: no JIT, no unsigned executable memory, no DYLD environment
  variables, no disabled library validation, no debugger attachment. WKWebView
  runs JavaScript in Apple's own WebContent process, so the app needs no JIT.

  The App Sandbox stays off on purpose: Portico must read ~/.ssh/config, keys and
  known_hosts and talk to the ssh-agent socket (CLAUDE.md, "respect du setup
  existant"). See docs/RELEASE.md.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
