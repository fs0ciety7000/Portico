{
  "name": "portico-gui",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && node --test scripts/test-shortcuts.ts scripts/test-hostlist.ts scripts/test-panes.ts scripts/test-recording.ts scripts/test-hostform.ts scripts/test-import.ts scripts/test-webgl.ts scripts/test-terminal.ts scripts/test-paths.ts scripts/test-webview.ts scripts/test-sync.ts && node scripts/gen-keybindings.ts --check",
    "test:shortcuts": "node --test scripts/test-shortcuts.ts",
    "test:panes": "node --test scripts/test-panes.ts",
    "e2e": "e2e/run.sh",
    "check:keybindings": "node scripts/gen-keybindings.ts --check",
    "gen:keybindings": "node scripts/gen-keybindings.ts",
    "tauri": "tauri",
    "build:demo": "vite build --mode demo"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource/geist-sans": "5.2.5",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@tauri-apps/api": "~2.12.4",
    "@xterm/addon-fit": "~0.11.0",
    "@xterm/addon-web-links": "~0.12.0",
    "@xterm/addon-webgl": "~0.19.0",
    "@xterm/xterm": "~6.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "~7.3.1",
    "@tauri-apps/cli": "~2.12.3",
    "@tsconfig/svelte": "~5.0.8",
    "svelte": "~5.57.2",
    "svelte-check": "~4.7.7",
    "typescript": "~6.0.3",
    "vite": "~8.3.4"
  }
}
