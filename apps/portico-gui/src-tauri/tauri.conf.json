{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portico",
  "version": "0.1.0",
  "identifier": "dev.portico.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Portico",
        "width": 1280,
        "height": 800,
        "minWidth": 880,
        "minHeight": 560,
        "backgroundColor": "#0b0c0e",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "category": "DeveloperTool",
    "shortDescription": "Local-first, keyboard-first SSH workspace"
  }
}
