{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portico",
  "version": "0.2.2",
  "identifier": "dev.portico.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Portico",
        "width": 1280,
        "height": 800,
        "minWidth": 880,
        "minHeight": 560,
        "backgroundColor": "#0b0c0e",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "app", "dmg"],
    "publisher": "Portico contributors",
    "homepage": "https://github.com/fs0ciety7000/Portico",
    "copyright": "Copyright © 2026 Portico contributors",
    "license": "MIT OR Apache-2.0",
    "category": "DeveloperTool",
    "shortDescription": "Local-first, keyboard-first SSH workspace",
    "longDescription": "Portico is a fast, keyboard-first SSH session manager. It reads ~/.ssh/config, known_hosts, ssh-agent and local keys as the source of truth, works offline without an account, keeps secrets in the system keyring, and offers terminals, SFTP, port forwarding, key management and snippets.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "net",
        "priority": "optional",
        "depends": ["libdbus-1-3", "libc6 (>= 2.35)"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "../../../packaging/macos/Entitlements.plist",
      "infoPlist": "../../../packaging/macos/Info.plist"
    }
  }
}
